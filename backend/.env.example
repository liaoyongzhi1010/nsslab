# 当前启用的 LLM Provider。可选：local / openai_compatible
LLM_PROVIDER=openai_compatible

# 以下四项用于任意 OpenAI-compatible 服务。
# Qwen（中国大陆/北京默认业务空间）示例：
LLM_PROVIDER_NAME=Qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=replace-with-your-api-key

# 通用生成参数
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1800
LLM_FALLBACK_TO_LOCAL=true

# 正式环境使用 PostgreSQL；请为生产部署替换强密码。
APP_ENV=development
DATABASE_URL=postgresql+psycopg://cryptolab:change-me@127.0.0.1:5432/cryptolab
DATABASE_AUTO_CREATE=false
UPLOAD_DIR=./uploads

# 登录与服务端会话。初始账号只在数据库中不存在同名用户时创建。
REGISTRATION_ENABLED=true
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_ADMIN_DISPLAY_NAME=平台管理员
AUTH_STUDENT_USERNAME=student
AUTH_STUDENT_PASSWORD=replace-with-a-strong-student-password
AUTH_STUDENT_DISPLAY_NAME=实验学生
